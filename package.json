{
  "name": "greenspoon-tracker",
  "version": "1.2.0",
  "description": "Greenspoon Box Tracking System - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "cd backend && node server.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64"
  },
  "keywords": [
    "box-tracker",
    "greenspoon",
    "delivery"
  ],
  "author": "Greenspoon",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.greenspoon.tracker",
    "productName": "Greenspoon Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "Frontend/**/*",
      "backend/**/*",
      "database",
      "coolerbox.jpg",
      "logo.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Greenspoon Tracker"
    }
  }
}
